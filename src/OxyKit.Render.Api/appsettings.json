{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "RequireLocalRequests": true,
    "ApiKeyHeader": "X-OxyKit-Render-Key",
    "ApiKey": "",
    "Jwt": {
      "Key": "",
      "Issuer": "",
      "Audience": ""
    }
  },
  "Rendering": {
    "MaxHtmlContentChars": 1000000,
    "MaxCsvContentChars": 1000000,
    "MaxRequestBodyBytes": 5242880,
    "MaxConcurrentRenders": 4,
    "TemplatesRoot": "templates",
    "MaxTemplateChars": 500000,
    "MaxContractChars": 100000
  }
}
