{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxykit.dev/templates/invoice/contract.json",
  "title": "Invoice",
  "type": "object",
  "additionalProperties": false,
  "required": ["invoiceNumber", "customerName", "total", "lines"],
  "properties": {
    "invoiceNumber": {
      "type": "string",
      "minLength": 1
    },
    "customerName": {
      "type": "string",
      "minLength": 1
    },
    "customerAddress": {
      "type": "string"
    },
    "issuerName": {
      "type": "string"
    },
    "issuerAddress": {
      "type": "string"
    },
    "issueDate": {
      "type": "string"
    },
    "dueDate": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "notes": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "amount"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "amount": { "type": "number" }
        }
      }
    }
  }
}
