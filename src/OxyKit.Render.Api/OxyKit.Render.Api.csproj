<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OxyKit.Render.Api.Tests" />
    <InternalsVisibleTo Include="OxyKit.Render.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="OxyKit.Observability" Version="0.1.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML/SVG land as None (not Content); JSON is Content. Copy both on publish (Linux Docker + local). -->
    <None Update="templates/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="templates/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OxyKit.Render.Core\OxyKit.Render.Core.csproj" />
    <ProjectReference Include="..\OxyKit.Render.Contracts\OxyKit.Render.Contracts.csproj" />
  </ItemGroup>
</Project>
